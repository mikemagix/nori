package web

templ ServiceFormPage(form ServiceFormData, csrf string, isEdit bool, action string, errMsg string) {
	@Layout(formTitle(isEdit), csrf, serviceFormContent(form, csrf, isEdit, action, errMsg))
}

func formTitle(isEdit bool) string {
	if isEdit {
		return "Edit service"
	}
	return "New service"
}

templ serviceFormContent(form ServiceFormData, csrf string, isEdit bool, action string, errMsg string) {
	<div class="breadcrumb"><a href={ serviceBackURL(form, isEdit) }>← Back</a></div>
	<section class="page-heading form-heading">
		<div>
			<p class="eyebrow">Configuration</p>
			<h1>{ formTitle(isEdit) }</h1>
			if form.IsSelf {
				<p class="page-subtitle">Launcher-managed self-update. You can change its deployment policy and runtime environment, but the image and handoff are protected.</p>
			} else {
				<p class="page-subtitle">Define what to watch and exactly how this service is deployed.</p>
			}
		</div>
	</section>
	if errMsg != "" {
		<div class="alert alert-error" role="alert">
			<strong>Couldn’t save the service</strong>
			<span>{ errMsg }</span>
		</div>
	}
	<form id="service-form" method="post" action={ templ.SafeURL(action) } class="service-form" data-deployment-form>
		<input type="hidden" name="csrf_token" value={ csrf }/>
		<section class="panel form-panel">
			<div class="panel-heading">
				<div>
					<h2>Service details</h2>
					<p>The image and policy Nori should track.</p>
				</div>
				<span class="step-number">01</span>
			</div>
			<div class="form-grid">
				<div class="field">
					<label for="name">Service name</label>
					if isEdit {
						<input id="name" name="name" value={ form.Name } required readonly/>
					} else {
						<input id="name" name="name" value={ form.Name } required placeholder="analytics-api" pattern="[A-Za-z0-9][A-Za-z0-9._-]*"/>
					}
					<span class="field-help">Used for the <code>nori.service</code> container label.</span>
				</div>
				<div class="field">
					<label for="watched-image">Watched image</label>
					<input id="watched-image" name="watched_image" value={ form.WatchedImage } required placeholder="ghcr.io/you/app:latest" readonly?={ form.IsSelf }/>
					<span class="field-help">The tag checked for newly published digests.</span>
				</div>
				<div class="field">
					<label for="policy">Deployment policy</label>
					<select id="policy" name="policy" data-policy-select>
						<option value="manual" selected?={ form.Policy == "manual" }>Manual only</option>
						<option value="immediate" selected?={ form.Policy == "immediate" }>Deploy immediately</option>
						<option value="scheduled" selected?={ form.Policy == "scheduled" }>On a schedule</option>
					</select>
					<span class="field-help">Controls what happens when a new digest is found.</span>
				</div>
				<div class="field" data-cron-field>
					<label for="cron-expr">Cron expression</label>
					<input id="cron-expr" name="cron_expr" value={ form.CronExpr } placeholder="0 3 * * *"/>
					<span class="field-help">For example, <code>0 3 * * *</code> deploys daily at 03:00.</span>
				</div>
				<div class="field">
					<label for="health-url">Health URL</label>
					<input id="health-url" name="health_url" value={ form.HealthURL } placeholder="https://service.example/health"/>
					<span class="field-help">Optional health probe URL. If empty, no per-service probe is performed.</span>
				</div>
				if !form.IsSelf {
					<div class="field">
						<label for="deployment-mode">Deployment mode</label>
						<select id="deployment-mode" name="deployment_mode" data-deployment-mode>
							<option value="custom" selected?={ form.DeploymentMode == "custom" }>Custom deployment script</option>
							<option value="single_container" selected?={ form.DeploymentMode == "single_container" }>Single container</option>
							<option value="postgres" selected?={ form.DeploymentMode == "postgres" }>Application with PostgreSQL</option>
						</select>
						<span class="field-help">Templates manage an owned Docker lifecycle; Custom keeps the current Bash contract.</span>
					</div>
				}
			</div>
		</section>

		<div class="editor-grid" data-deployment-mode-panel="custom" hidden?={ !form.IsSelf && form.DeploymentMode != "custom" }>
		<section class="panel editor-panel">
			<div class="panel-heading">
				<div>
					<h2>Deployment script</h2>
					<p>Runs with <code>$SERVICE</code>, <code>$IMAGE</code>, <code>$TARGET_IMAGE</code>, <code>$TARGET_DIGEST</code> and <code>$ENV_FILE</code> injected.</p>
				</div>
				<div class="panel-heading-actions">
					<div class="editor-health" data-validation-status="bash"><span class="validation-dot"></span><span data-validation-message>Checking Bash…</span></div>
					<span class="step-number">02</span>
				</div>
			</div>
            if isEdit {
                @configHistory(form.Name, "script", "deploy_script", form.IsSelf)
            }
			<textarea class="code-editor" name="deploy_script" data-editor="bash" aria-label="Bash deployment script" spellcheck="false" placeholder="# Injected: $SERVICE $IMAGE $TARGET_IMAGE $TARGET_DIGEST $ENV_FILE (+ your .env vars)&#10;# $ENV_FILE is this service's .env, ready for docker run --env-file.&#10;&#10;docker pull $TARGET_IMAGE&#10;docker rm -f $SERVICE 2&gt;/dev/null || true&#10;docker run -d --name $SERVICE --label nori.service=$SERVICE --env-file $ENV_FILE $TARGET_IMAGE" readonly?={ form.IsSelf }>{ form.DeployScript }</textarea>
			<div class="editor-footer">
				<span>Bash · syntax checked before save and deploy</span>
				<span><kbd>⌘</kbd><kbd>S</kbd> to save</span>
			</div>
		</section>
		</div>

		<section class="panel form-panel" data-deployment-mode-panel="single_container" hidden?={ form.DeploymentMode != "single_container" }>
			<div class="panel-heading"><div><h2>Single-container template</h2><p>Structured configuration for the managed application container. Values in the environment editor remain encrypted and are never included here.</p></div><span class="step-number">02</span></div>
			<div class="form-grid"><div class="field form-notes"><label for="template-config">Template configuration</label><textarea id="template-config" name="template_config_single" class="code-editor" spellcheck="false" aria-label="Single-container template configuration" placeholder='{"version":1,"internal_port":8080,"restart_policy":"unless-stopped","health":{"url":"https://app.example/health","timeout_seconds":30}}'>{ form.TemplateConfig }</textarea><span class="field-help">Use a versioned JSON object. Include named volumes, serving network, proxy settings, and exactly one bounded health URL or command when needed.</span></div></div>
			if form.TemplatePreview != "" {
				<div class="form-notes"><span class="field-help">Read-only deployment preview</span><pre class="history-preview">{ form.TemplatePreview }</pre></div>
			}
		</section>

		<section class="panel form-panel" data-deployment-mode-panel="postgres" hidden?={ form.DeploymentMode != "postgres" }>
			<div class="panel-heading"><div><h2>Application with PostgreSQL</h2><p>Use the same structured application fields plus an explicit PostgreSQL image and environment key bindings.</p></div><span class="step-number">02</span></div>
			<div class="form-grid"><div class="field form-notes"><label for="template-config-postgres">Template configuration</label><textarea id="template-config-postgres" name="template_config_postgres" class="code-editor" spellcheck="false" aria-label="PostgreSQL template configuration" placeholder='{"version":1,"internal_port":8080,"restart_policy":"unless-stopped","health":{"command":"curl -f http://localhost:8080/health","timeout_seconds":30},"postgres":{"image":"postgres:16.4","database":"app","user":"app","password_env":"POSTGRES_PASSWORD","connection_url_env":"DATABASE_URL","ready_timeout_seconds":30}}'>{ form.TemplateConfig }</textarea><span class="field-help">Nori creates only labeled private database resources and requires a matching private connection URL before changing the application.</span></div></div>
			if form.TemplatePreview != "" {
				<div class="form-notes"><span class="field-help">Read-only deployment preview</span><pre class="history-preview">{ form.TemplatePreview }</pre></div>
			}
		</section>

		<div class="editor-grid">
		<section class="panel editor-panel">
			<div class="panel-heading">
				<div>
					<h2>Environment file</h2>
					if form.IsSelf {
						<p>Launcher-managed secrets are hidden and preserved. Save these values, then use Re-deploy to apply them.</p>
					} else {
						<p>Paste the complete contents of the service’s <code>.env</code> file.</p>
					}
				</div>
				<div class="panel-heading-actions">
					<div class="editor-health" data-validation-status={ environmentEditorKind(form) }><span class="validation-dot"></span><span data-validation-message>Checking .env…</span></div>
					<span class="step-number">03</span>
				</div>
			</div>
            if isEdit {
                @configHistory(form.Name, "env", "env_file", false)
            }
			<textarea class="code-editor" name="env_file" data-editor={ environmentEditorKind(form) } aria-label={ environmentEditorLabel(form) } spellcheck="false" placeholder="# One complete .env file&#10;DATABASE_URL=postgres://...&#10;LOG_LEVEL=info">{ form.EnvFile }</textarea>
			<div class="editor-footer">
				if form.IsSelf {
					<span class="secure-note">◆ Protected launcher keys stay hidden and unchanged</span>
					<span>Docker env-file syntax</span>
				} else {
					<span class="secure-note">◆ The complete file is encrypted at rest</span>
					<span>Dotenv syntax</span>
				}
			</div>
		</section>
		</div>

		<div class="form-actions">
			<a class="button button-secondary" href={ serviceBackURL(form, isEdit) }>Cancel</a>
			<button class="button button-primary" type="submit">Save service</button>
		</div>
	</form>
	if isEdit && !form.IsSelf && form.DeploymentMode != "custom" {
		<section class="danger-zone">
			<div><h2>Convert to Custom script</h2><p>This one-way conversion writes an inspectable Bash script and stops structured template management.</p></div>
			<form method="post" action={ templ.SafeURL("/services/" + form.Name + "/convert-to-custom") }><input type="hidden" name="csrf_token" value={ csrf }/><button class="button button-secondary" type="submit" onclick="return confirm('Convert this managed template to a Custom script?')">Convert to Custom</button></form>
		</section>
	}
	if isEdit && !form.IsSelf {
		<section class="danger-zone">
			<div>
				<h2>Delete service</h2>
				<p>Remove its configuration and deployment history from Nori.</p>
			</div>
			<form method="post" action={ templ.SafeURL("/services/" + form.Name + "/delete") }>
				<input type="hidden" name="csrf_token" value={ csrf }/>
				<button class="button button-danger" type="submit" onclick="return confirm('Delete this service and its history?')">Delete service</button>
			</form>
		</section>
	}
}

func serviceBackURL(form ServiceFormData, isEdit bool) templ.SafeURL {
	if isEdit {
		return templ.SafeURL("/services/" + form.Name)
	}
	return "/"
}

func environmentEditorKind(form ServiceFormData) string {
	if form.IsSelf {
		return "launcher-env"
	}
	return "dotenv"
}

func environmentEditorLabel(form ServiceFormData) string {
	if form.IsSelf {
		return "Launcher environment"
	}
	return "Dotenv environment file"
}


templ configHistory(name, kind, target string, readOnly bool) {
    <details class="config-history" data-history-kind={ kind } data-history-url={ "/services/" + name + "/history/" + kind } data-history-target={ target } data-history-source={ name }>
        <summary>Version history</summary>
        <div class="history-content">
            <label for={ "history-" + kind }>Saved version</label>
            <select id={ "history-" + kind } data-history-select disabled><option>Loading versions…</option></select>
            <textarea class="history-preview" data-history-preview readonly aria-label={ "Saved " + kind + " version" } spellcheck="false" placeholder="Select a version to preview its contents"></textarea>
            <div class="history-actions">
                if !readOnly {
                    <button type="button" class="button button-secondary button-small" data-history-use disabled>Use in editor</button>
                }
                <button type="button" class="button button-secondary button-small" data-history-copy disabled>Copy contents</button>
                <a class="button button-ghost button-small" data-history-new hidden>Use in new service</a>
            </div>
            <p class="field-help">Using a version fills the editor. Save the service to create a new version.</p>
            <p class="field-help" data-history-status role="status" aria-live="polite"></p>
        </div>
    </details>
}
