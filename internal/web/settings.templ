package web

import (
	"nori/internal/notify"
	"nori/internal/store"
)

templ SettingsPage(botName string, csrf string, errMsg string, saved bool, mcpConfig store.MCPConfig, mcpView mcpSettingsView, channels Channels, routing notify.Routing) {
	@Layout("Settings", csrf, settingsContent(botName, csrf, errMsg, saved, mcpConfig, mcpView, channels, routing))
}

templ settingsContent(botName string, csrf string, errMsg string, saved bool, mcpConfig store.MCPConfig, mcpView mcpSettingsView, channels Channels, routing notify.Routing) {
	<section class="page-heading form-heading">
		<div>
			<p class="eyebrow">Instance</p>
			<h1>Settings</h1>
			<p class="page-subtitle">Manage this instance’s name, notifications and agent access.</p>
		</div>
	</section>
	if errMsg != "" {
		<div class="alert alert-error" role="alert">
			<strong>Couldn’t save</strong>
			<span>{ errMsg }</span>
		</div>
	}
	if saved {
		<div class="alert alert-success" role="status">
			<strong>Saved</strong>
			<span>Settings updated. Notification and MCP access changes take effect immediately.</span>
		</div>
	}
	if mcpView.GrantRevoked {
		<div class="alert alert-success" role="status" tabindex="-1">
			<strong>Connection revoked</strong>
			<span>The selected OAuth connection can no longer access MCP. <a href="#connected-oauth-clients">Return to connections</a>.</span>
		</div>
	}
	if mcpView.GrantError != "" {
		<div class="alert alert-error" role="alert" tabindex="-1">
			<strong>Couldn’t revoke connection</strong>
			<span>{ mcpView.GrantError }</span>
		</div>
	}
	<form method="post" action="/settings" class="service-form">
		<input type="hidden" name="csrf_token" value={ csrf }/>
		<section class="panel form-panel">
			<div class="panel-heading">
				<div>
					<h2>Display name</h2>
					<p>Shown in the top bar and page title so you can tell instances apart across browser tabs.</p>
				</div>
				<span class="step-number">01</span>
			</div>
			<div class="form-grid">
				<div class="field">
					<label for="bot-name">Bot name</label>
					<input id="bot-name" name="bot_name" value={ botName } required maxlength="64" placeholder="Nori" autofocus/>
					<span class="field-help">Up to 64 characters. Does not change the internal <code>nori</code> service name.</span>
				</div>
			</div>
		</section>
		<section class="panel form-panel">
			<div class="panel-heading">
				<div>
					<h2>Notifications</h2>
					<p>Choose which events each channel receives. Changes apply to the next event; no restart needed.</p>
				</div>
				<span class="step-number">02</span>
			</div>
			<div class="channel-status">
				@channelStatusRow("Twilio SMS", "NORI_TWILIO_ACCOUNT_SID, NORI_TWILIO_AUTH_TOKEN, NORI_TWILIO_FROM, NORI_TWILIO_TO", channels.Twilio)
				@channelStatusRow("Telegram", "NORI_TELEGRAM_BOT_TOKEN, NORI_TELEGRAM_CHAT_ID", channels.Telegram)
			</div>
			<div class="table-wrap notify-matrix-wrap">
				<table class="notify-matrix">
					<thead>
						<tr>
							<th scope="col">Event</th>
							<th scope="col">Twilio SMS</th>
							<th scope="col">Telegram</th>
						</tr>
					</thead>
					<tbody>
						@notifyMatrixRow("Deploy failed", notify.KindDeployFailed, routing, channels)
						@notifyMatrixRow("Service down or unhealthy", notify.KindDown, routing, channels)
						@notifyMatrixRow("Service recovered", notify.KindRecovered, routing, channels)
						@notifyMatrixRow("Deploy succeeded", notify.KindSuccess, routing, channels)
					</tbody>
				</table>
			</div>
			<div class="form-notes notify-notes">
				<p class="field-help">Channels are configured through environment variables at startup and cannot be changed here. A channel that is configured later starts with all events enabled.</p>
			</div>
		</section>
		<section class="panel form-panel">
			<div class="panel-heading">
				<div>
					<h2>Agent access (MCP)</h2>
					<p>Connect agents to manage services through OAuth. Disabled by default.</p>
				</div>
				<span class="step-number">03</span>
			</div>
			<div class="form-grid">
				<div class="field">
					<label for="mcp-enabled">MCP server</label>
					<select id="mcp-enabled" name="mcp_enabled">
						<option value="0" selected?={ !mcpConfig.Enabled }>Disabled</option>
						<option value="1" selected?={ mcpConfig.Enabled }>Enabled</option>
					</select>
					<span class="field-help">Disabling access disconnects agents. Re-enabling requires a new authorization.</span>
				</div>
				<div class="field">
					<label for="mcp-public-url">Public instance URL</label>
					<input id="mcp-public-url" type="url" name="mcp_public_url" value={ mcpConfig.PublicURL } placeholder="https://nori.example.com" maxlength="2048"/>
					<script>
						(() => {
							const input = document.getElementById('mcp-public-url');
							if (!input.value) input.value = window.location.origin;
						})();
					</script>
					<span class="field-help">The HTTPS address agents, Telegram notification links, and your browser use to reach Nori, without a path. HTTP is accepted only for local development.</span>
				</div>
				<div class="form-notes">
					if mcpConfig.Enabled {
						<p class="field-help">Connect your MCP client to <code style="overflow-wrap:anywhere">{ mcpConfig.PublicURL + "/mcp" }</code>. Sign in to Nori and approve the requested permissions.</p>
					}
					<p class="field-help">Read access includes logs with known dotenv values redacted; other sensitive output may remain. Write access can deploy scripts with Nori’s permissions on the Docker host. Approve only clients you trust.</p>
				</div>
			</div>
		</section>
		<div class="form-actions">
			<button class="button button-primary" type="submit">Save settings</button>
		</div>
	</form>
	if mcpConfig.Enabled {
		<section class="panel oauth-grant-inventory" aria-labelledby="connected-oauth-clients">
			<div class="panel-heading">
				<div>
					<h2 id="connected-oauth-clients">Connected OAuth clients</h2>
					<p>Review each approved client connection. Revoking one connection leaves other clients and grants in place.</p>
				</div>
			</div>
			if mcpView.InventoryUnavailable {
				<div class="oauth-grant-unavailable" role="alert">
					<strong>Connections unavailable</strong>
					<p>Couldn’t load OAuth connections. No connection status is shown until this can be read safely.</p>
				</div>
			} else if len(mcpView.Registrations) == 0 {
				<p class="oauth-grant-empty">No approved OAuth clients are connected.</p>
			} else {
				for _, registration := range mcpView.Registrations {
					<section class="oauth-registration">
						<div class="oauth-registration-heading">
							<div>
								<h3>{ registration.ClientName }</h3>
								<p>Approved { registration.ApprovedAt.Format("Jan 2, 2006 15:04 MST") }</p>
							</div>
						</div>
						<div class="table-wrap oauth-grant-table-wrap">
							<table class="oauth-grant-table" aria-label={ "OAuth grants for " + registration.ClientName }>
								<thead>
									<tr>
										<th scope="col">Scopes</th>
										<th scope="col">Approved</th>
										<th scope="col">Expires</th>
										<th scope="col">Status</th>
										<th scope="col"><span class="sr-only">Connection actions</span></th>
									</tr>
								</thead>
								<tbody>
									for _, grant := range registration.Grants {
										<tr>
											<td data-label="Scopes" class="oauth-grant-scopes">{ grant.Scopes }</td>
											<td data-label="Approved">{ grant.ApprovedAt.Format("Jan 2, 2006 15:04 MST") }</td>
											<td data-label="Expires">{ grant.ExpiresAt.Format("Jan 2, 2006 15:04 MST") }</td>
											<td data-label="Status"><span class="badge oauth-grant-status" data-status={ string(grant.Status) }>{ grant.Status }</span></td>
											<td data-label="Action" class="oauth-grant-action">
												if grant.Status == store.OAuthGrantActive {
													<a class="button button-danger" href={ "/settings/mcp/grants/" + grant.ManagementID + "/revoke" } aria-label={ "Revoke " + grant.ClientName + " OAuth connection approved " + grant.ApprovedAt.Format("Jan 2, 2006 15:04 MST") }>Revoke</a>
												} else {
													<span class="oauth-grant-no-action">No action available</span>
												}
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>
					</section>
				}
			}
		</section>
		<section class="danger-zone">
			<div>
				<h2>Revoke agent access</h2>
				<p>Invalidate every existing OAuth grant. Agents must request authorization again.</p>
			</div>
			<form method="post" action="/settings/mcp/revoke">
				<input type="hidden" name="csrf_token" value={ csrf }/>
				<button class="button button-danger" type="submit">Revoke all agent access</button>
			</form>
		</section>
	}
}

templ MCPGrantRevokeConfirmPage(botName string, csrf string, grant store.OAuthGrant) {
	@Layout("Revoke OAuth connection", csrf, mcpGrantRevokeConfirmContent(botName, csrf, grant))
}

templ mcpGrantRevokeConfirmContent(botName string, csrf string, grant store.OAuthGrant) {
	<section class="page-heading form-heading">
		<div>
			<p class="eyebrow">Agent access (MCP)</p>
			<h1>Revoke connection</h1>
			<p class="page-subtitle">Confirm that this one OAuth connection should lose access. Other clients and grants stay connected.</p>
		</div>
	</section>
	<section class="panel oauth-grant-confirmation" aria-labelledby="revoke-connection-details">
		<div class="panel-heading">
			<div>
				<h2 id="revoke-connection-details">Connection to revoke</h2>
				<p>Its active access and refresh credentials will stop working immediately.</p>
			</div>
		</div>
		<dl class="oauth-grant-details">
			<div>
				<dt>OAuth client</dt>
				<dd>{ grant.ClientName }</dd>
			</div>
			<div>
				<dt>Approved scopes</dt>
				<dd>{ grant.Scopes }</dd>
			</div>
			<div>
				<dt>Approved</dt>
				<dd>{ grant.ApprovedAt.Format("Jan 2, 2006 15:04 MST") }</dd>
			</div>
			<div>
				<dt>Expires</dt>
				<dd>{ grant.ExpiresAt.Format("Jan 2, 2006 15:04 MST") }</dd>
			</div>
		</dl>
		<form method="post" action={ "/settings/mcp/grants/" + grant.ManagementID + "/revoke" } class="oauth-grant-confirm-actions">
			<input type="hidden" name="csrf_token" value={ csrf }/>
			<button class="button button-ghost" type="submit" name="decision" value="cancel">Cancel</button>
			<button class="button button-danger" type="submit" name="decision" value="revoke">Revoke connection</button>
		</form>
	</section>
}

templ channelStatusRow(name string, envVars string, configured bool) {
	<div class="channel-row">
		<div class="channel-name">
			<strong>{ name }</strong>
			if configured {
				<span class="badge badge-notify-configured">Configured</span>
			} else {
				<span class="badge badge-notify-missing">Not configured</span>
			}
		</div>
		if !configured {
			<p class="field-help">Set <code>{ envVars }</code> and restart Nori to enable this channel.</p>
		}
	</div>
}

templ notifyMatrixRow(label string, kind notify.EventKind, routing notify.Routing, channels Channels) {
	<tr>
		<th scope="row">{ label }</th>
		for _, ch := range notify.Channels {
			<td>
				if channels.has(ch) {
					<input type="checkbox" name={ "notify_" + ch + "_" + string(kind) } value="1" checked?={ routing.Allowed(ch, kind) } aria-label={ label + " via " + ch }/>
				} else {
					<input type="checkbox" name={ "notify_" + ch + "_" + string(kind) } value="1" disabled aria-label={ label + " via " + ch }/>
				}
			</td>
		}
	</tr>
}
